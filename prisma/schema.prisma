// مخطط قاعدة البيانات - MyNet Web
// المرحلة 1: نمذجة كاملة للجداول المقابلة لبرنامج MyNet.v4
// ملاحظة: نحتفظ بالمعرّفات الأصلية (id) لتبقى العلاقات صحيحة بعد النقل.
// المفاتيح الأجنبية حقول Int بسيطة (كما في الأصل) لضمان نقل مرن دون فشل بسبب سجلات يتيمة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== المستخدمون والصلاحيات =====
enum Role {
  ADMIN
  ACCOUNTANT
  CASHIER
  TECHNICIAN
  VIEWER
}

// ===== الوكيل (المستأجر): مالك النظام يدير عدّة وكلاء، كل وكيل يدير مكاتبه =====
model Agent {
  id         Int       @id @default(autoincrement())
  name       String // اسم/علامة الوكيل — يظهر بكامل البرنامج له
  officeCap  Int       @default(1) // أقصى عدد مكاتب يسمح له بإنشائها
  maxManagers    Int   @default(1) // أقصى عدد مدراء (مستخدم isAdmin)
  maxUsers       Int   @default(1) // أقصى عدد مستخدمين عاديين
  maxTechnicians Int   @default(3) // أقصى عدد فنيين
  maxSubscribers Int   @default(3000) // أقصى عدد مشتركين ضمن مكاتب الوكيل
  planExpiry DateTime? // تاريخ انتهاء الاشتراك (null = بلا انتهاء)
  isTrial    Boolean   @default(false) // حساب تجريبي (أسبوع)
  approved   Boolean   @default(true) // موافقة المالك — التجريبي يبدأ false حتى يوافق المالك
  backupEmail String? // إيميل النسخ الاحتياطي/الاسترجاع — تُرسل إليه نسخة يومية
  // إذن مالك النظام للميزة ٢ من مهلة أودو (الإرسال التلقائيّ: ملاحظة أودو + واتساب المشترك).
  // بلا هذا الإذن **لا يظهر المفتاح للوكيل إطلاقاً** ولا أثرَ للميزة. والإذن يجعلها **متاحةً لا
  // مفروضة**: المدير/المستخدم يشعلها لكلّ مكتبٍ ويطفئها كما يشاء (طلب محمد 2026-08-09).
  odooSlaSendAllowed Boolean @default(false)
  // أ-٢٣ · حصّةُ مالك النظام: **كم مكتباً** من مكاتب هذا الوكيل يُسمح له بأكثر من لوحة ساس.
  // طلبُ محمد 2026-08-13: «إذا الوكيل له ٣ مكاتب فيمكنني اختيار كم مكتبٍ بساسَين وكم بساسٍ
  // واحد، وأيضاً **صفر** ليبقى على الوضع الحالي». فليست مفتاحاً ثنائيّاً بل عدداً.
  // صفر = الوضعُ الحاليُّ تماماً (لا خيارَ يظهر للوكيل). والحصّةُ **تُتيح لا تُشعِل**.
  multiSasOffices Int @default(0)
  // فترة احتساب رواتب الموظفين (عامة لكل مكاتب الوكيل) — يضبطها المدير ويغيّرها متى شاء
  salaryPeriodFrom String? // (مهجور) YYYY-MM-DD — بداية الفترة بالتاريخ الكامل (النموذج القديم)
  salaryPeriodTo   String? // (مهجور) YYYY-MM-DD — نهاية الفترة بالتاريخ الكامل (النموذج القديم)
  salaryFromDay    Int? // يوم بداية الفترة (1-31) — متكرّرة كل شهر بلا شهر/سنة
  salaryToDay      Int? // يوم نهاية الفترة في الشهر التالي (1-31)
  lastBackupDate   String? // آخر يومٍ (بغداد) أُرسلت فيه النسخة اليومية — يمنع الازدواج بين السحابة والحاسبة
  // رابط دور قاعدة العامل لهذا الوكيل — يُدار بـSQL خام في agentDbRole.ts؛ أُدخل
  // للمخطط بعد اختبار الاستعادة (2026-08-02): كان خارجه فيفشل التعافي المبني على المخطط
  workerDbUrl      String?
  // بصمات (sha256) الروابط السابقة — بها تُثبت حاسبة تحمل رابطاً قديماً هويتها فتستلم
  // الرابط الجديد وحدها (الربط الذاتي 2026-08-02). بصمات فقط لا روابط — أأمن تخزيناً.
  prevUrlHashes    String?
  isDeleted  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@map("agents")
}

// خرائط أدوار قاعدة العامل (دور PG ← وكيله) — تُدار بـSQL خام في agentDbRole.ts.
// أُدخلت للمخطط بعد اختبار الاستعادة (2026-08-02): كانت خارجه فتضيع بياناتها
// بصمت في أي تعافٍ يبني الهيكل من المخطط ثم يستعيد النسخة الكاملة.
model DbAgentRole {
  roleName String @id @map("role_name")
  agentId  Int    @map("agent_id")

  @@map("db_agent_roles")
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  username  String   @unique
  password  String
  plainPassword String? // نسخة قابلة للعرض للمالك (تُضبط عند إنشاء/تعيين المالك للكلمة)
  recoveryEmail String? // إيميل استرجاع كلمة السر (يُستخدم للمالك؛ المدير يستخدم Agent.backupEmail)
  resetToken String? // رمز إعادة تعيين كلمة السر (مؤقّت)
  resetExpiry DateTime? // انتهاء صلاحية رمز إعادة التعيين
  role      Role     @default(VIEWER)
  isAdmin   Boolean  @default(false) // مدير كامل الصلاحيات
  isOwner   Boolean  @default(false) // مالك النظام (فوق المدير) — يدير الوكلاء فقط
  agentId   Int? // الوكيل (المستأجر) الذي ينتمي إليه هذا المستخدم
  permissions String? // صلاحيات مفصولة بفواصل
  towerId   Int? // البرج الذي يتحكم به هذا المستخدم (المكتب)
  managerPhone String? // رقم المدير لإرسال التقرير اليومي
  fcmToken  String? // رمز جهاز FCM (التطبيق الأصلي) — لإشعارات الهاتف حين لا يدعم المتصفح Web Push
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  failedAttempts Int   @default(0) // محاولات دخول فاشلة متتالية (لمنع التخمين)
  lockedUntil DateTime? // قفل الحساب مؤقتاً بعد محاولات كثيرة
  sessionToken String? // جلسة واحدة: أي دخول جديد يولّد رمزاً ويُبطل الأجهزة الأخرى
  legacyId  Int? // معرّف المستخدم في البرنامج القديم
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("users")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("audit_logs")
}

// ===== المجموعات (group_brig) =====
model Group {
  id        Int     @id @default(autoincrement())
  name      String?
  balance   Float   @default(0)
  isDeleted Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("groups")
}

// ===== الأبراج / القواطع (brig) =====
model Tower {
  id          Int     @id @default(autoincrement())
  name        String?
  agentId     Int? // الوكيل (المستأجر) الذي يملك هذا المكتب
  address     String?
  note        String?
  phone       String?
  loginUrl    String? // رابط لوحة SAS4 (الدخول)
  activationTemplate String? // قالب رابط تفعيل المشترك، مثال: http://sas/admin?user={user}
  username    String? // اسم مستخدم الدخول للوحة SAS4
  password    String?
  passOnline  String?
  type        Int?
  price       Int?
  nesba       Int? // النسبة
  groupId     Int?
  isMain      Int?
  allowAdd    Int?
  allowSms    Int?
  month       Int?
  activationMode String? @default("month") // نظام التفعيل: month = نفس تاريخ اليوم بالشهر التالي، days30 = 30 يوماً
  managerPhone String? // رقم مدير هذا المكتب (لإرسال التقرير اليومي)
  mapArea     String? // رمز منطقة الخريطة لهذا المكتب (مثل MWA/ENT/SLM/KAD...) لتحديد مواقع المشتركين
  rewardsEnabled String? @default("0") // 1 = تفعيل نظام مكافآت المشتركين لهذا المكتب
  silent      String? @default("1") // 1 = إرسال صامت افتراضي لهذا المكتب
  waEnabled   String? @default("1") // 1 = تفعيل واتساب لهذا المكتب
  syncEnabled String? @default("0") // 1 = تفعيل المزامنة اليومية التلقائية
  debtReminderEnabled String? @default("0") // 1 = إرسال رسائل ديون يومية لمشتركي المكتب الذين عليهم دين
  debtReminderTime String? // وقت رسائل الديون اليومي (HH:MM) — فارغ = يتبع وقت تذكير الانتهاء reminderTime
  autoAssignEnabled Boolean @default(false) // 1 = التوزيع التلقائي للبطاقات مفعَّل لهذا المكتب (بوّابة المكتب)
  // قروض سوبر سيل (فزعة) — إعداد للمدير حصراً. إطفاؤه يُخفي الميزة بلا محو البيانات.
  loanEnabled String? @default("0") // 1 = تفعيل نظام القرض لهذا المكتب
  loanUser    String? // اسم مستخدم لوحة قروض سوبر سيل (dealer) — لا يُرسَل لغير المدير
  loanPass    String? // كلمة مرور القروض — مشفّرة عبر secretbox (enc:v1:)
  // طريقة القرض للمكتب كلّه: activation = قرض كتفعيل (تمديد + دَين + رسالة)؛
  // normal = قرض عادي (تمديد ٣٠ يوماً فقط، بلا دَين ولا رسالة ولا أيّ أثر)
  loanMode    String? @default("activation")
  // ربط تذاكر أودو (Helpdesk) — إعداد للمكتب (مدير أو مستخدم). العمليّات محليّة على العامل حصراً (لا سحابة).
  odooEnabled String? @default("0") // 1 = تفعيل ربط أودو لهذا المكتب
  odooUser    String? // مستخدم بوّابة أودو للمكتب — لا يُرسَل بصيغته الخام لغير مكتبه
  odooPass    String? // كلمة مرور أودو — نصٌّ صريح (كـSAS): يقرؤها العامل المحليّ بلا مفتاح تشفير. لا تُعرَض في أيّ واجهة/API.
  odooUrl     String? @default("https://odoo.supercell.iq") // أساس بوّابة أودو
  odooUid     Int? // uid حساب المكتب في أودو (يُملأ عند أوّل دخول ناجح — لمطابقة Assigned to)
  odooLastOk  DateTime? // آخر دخول ناجح للعامل (الشارة الديناميّة: أخضر/أحمر)
  odooLastError String? // آخر رسالة خطأ دخول (تشخيص الشارة الحمراء)
  odooLastTicketId Int? // العلامة المائيّة: رقم آخر تذكرة مجلوبة لهذا المكتب (id تصاعديّ)
  // ===== مهلة سوبر سيل — ميزتان بمفتاحين منفصلين (طلب محمد 2026-08-09) =====
  // الميزة ١ «إنذارات أودو»: حساب/وميض/عدّاد/إشعار المدير/تنبيه الفنيّ — لكلّ الوكلاء بلا إذن.
  odooSlaAlarm    String?   @default("0") // 1 = مُفعَّلة لهذا المكتب
  odooSlaTechText String? // نصّ تنبيه الفنيّ كلّ ١٥ دقيقة (فارغ = نصّ افتراضيّ)
  // الميزة ٢ «إرسال رسائل أودو والمشتركين»: لا تظهر إلّا بإذن المالك (Agent.odooSlaSendAllowed)،
  // ولا تُفعَّل إلّا والميزة ١ مُشعَلة.
  odooSlaAuto     String?   @default("0") // 1 = إرسالٌ تلقائيّ (ملاحظة أودو ثمّ واتساب المشترك)
  odooSlaArmedAt  DateTime? // لحظة تشعيل الإرسال: ما سُحب **قبلها** لا يُرسَل تلقائيّاً أبداً (منع رشقة أولى)
  odooSlaAlarmMin Int? // عتبة الإنذار الأحمر بدقائق النافذة (فارغ = ٦٠)
  odooSlaSendMin  Int? // عتبة الإرسال التلقائيّ بدقائق النافذة (فارغ = ٩٠)
  odooSlaNote     String? // نصّ ملاحظة التأجيل في أودو (فارغ = نصّ افتراضيّ)
  odooSlaWaText   String? // نصّ رسالة الواتساب للمشترك (فارغ = نصّ افتراضيّ)
  syncTime    String? // وقت مزامنة الاشتراكات اليومية مع SAS (HH:MM)
  reminderTime String? // وقت تذكير الانتهاء اليومي لهذا المكتب (HH:MM) — مرتبط بوقت تشغيل حاسبته؛ فارغ = وقت الوكيل العام
  reminderDays Int? // عدد أيام تذكير الانتهاء لهذا المكتب (يُرسَل لمن ينتهي خلالها) — فارغ = يومان (طلب محمد 2026-08-09)
  lastReminderDate String? // آخر يوم (YYYY-MM-DD) أُرسل/عولج فيه تذكير الانتهاء (لمنطق الموافقة عند الدخول)
  lastReportDate String? // آخر يوم (YYYY-MM-DD) أُرسل فيه التقرير اليومي للمدير (لمنع تكراره)
  // موقع المكتب للبصمة الجغرافية (الفني لا يبصم إلا داخل النطاق)
  lat         Float? // خط العرض
  lng         Float? // خط الطول
  geoRadius   Int?    @default(200) // نصف قطر النطاق المسموح بالأمتار
  geoEnabled  Boolean @default(false) // تفعيل التحقّق من الموقع عند البصمة
  isDeleted   Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([groupId])
  @@map("towers")
}

// ===== معلومات البرج الفنية (brgInfo) =====
model TowerInfo {
  id         Int     @id @default(autoincrement())
  sector     String?
  towerId    Int? // brg_fk
  ip         String?
  username   String?
  password   String?
  type       String?
  userCount  Int?
  channel    String?
  company    String?
  address    String?
  notes      String?
  isDeleted  Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([towerId])
  @@map("tower_info")
}

// ===== الباقات (card) =====
model Package {
  id          Int     @id @default(autoincrement())
  agentId     Int? // الوكيل (المستأجر) مالك هذا الإعداد
  name        String?
  priceDollar Float? // card_priceDO
  priceDinar  Float?
  addPrice    Float? // card_add
  cardCost    Float? // سعر شراء/كلفة الكارت الواحد لهذه الفئة (لديون الكارتات)
  rewardAmount Int? // مبلغ مكافأة التفعيل لهذه الباقة (لكل شهر) — نظام أكواد المكافآت
  towerId     Int? // card_brigfk
  isDeleted   Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([towerId])
  @@map("packages")
}

// ===== المشتركون (costumer) =====
model Subscriber {
  id           Int       @id @default(autoincrement())
  name         String?
  // مسح نهائي: بياناته مُحيت ولا يُسترجَع — ويبقى اسمه وحده كي تُقرأ وصولاته القديمة
  purgedAt     DateTime?
  phone        String?
  address      String?
  packageId    Int? // cost_cardFk
  note         String?
  dateFrom     DateTime?
  dateTo       DateTime?
  towerId      Int? // cost_bregFk
  groupId      Int? // cost_GroupFk
  month        Int?
  money        Float?
  wasel        Float? // المبلغ الواصل
  carry        Float? // الدين المرحّل
  sector       String?
  state        String?
  type         Int?
  smsEnabled   Int? // cost_sms
  waEnabled    Boolean @default(true) // إرسال واتساب لهذا المشترك (افتراضي مفعّل)
  createdByUser String? // cost_user
  createdByName String? // cost_userName
  wifiUser     String?
  wifiPass     String?
  netUser      String? // اسم مستخدم المشترك في SAS4
  transferredAt DateTime? // وقت تحويل يوزره عبر تكت تحويل (يُنبَّه عند التفعيل، ويُحذف بعد 30 يوماً دون تفعيل)
  transferredTo String? // اليوزر الجديد بعد التحويل (للتنبيه)
  rewardCode   String? // كود المكافأة الحالي (8 خانات) — نظام أكواد المكافآت
  rewardBalance Int?  @default(0) // رصيد المكافأة المتراكم (يُخصم عند الاستخدام)
  rewardGrantCount Int @default(0) // عدد منح المكافأة المتراكمة منذ آخر سحب — عند 10 يتوقف المنح حتى سحبٍ (كلي/جزئي) يصفّره
  sasId        Int? // معرّف المشترك في SAS4 (للربط والتفعيل)
  // أ-٢٣ · لوحةُ الساس التي يتبعها هذا المشترك — بها يُفعَّل. فارغٌ = أعمدةُ المكتب (السلوكُ القديم)
  sasPanelId   Int?
  cardCode     String? // cardID
  // حقول شاشة المشترك التفصيلية
  subPassword  String? // باسورد الاشتراك
  userNano     String? // يوزر الناتو
  passNano     String? // باسورد الناتو
  ipNano       String? // ايبي الناتو
  ftth         String? // معرّف ftth
  telegram     String? // التلكرام
  employee     String? // الموظف / قسم الحسابات
  tele         String?
  mac          String?
  affiliate    String?
  lastSmsDate  DateTime?
  isDeleted    Boolean   @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([packageId])
  @@index([towerId])
  @@index([groupId])
  @@index([phone])
  @@index([name])
  @@index([isDeleted, towerId, name]) // يطابق فلترة+ترتيب قائمة المشتركين
  @@index([towerId, netUser]) // مطابقة اليوزر السريعة لسحب كود المكافأة
  @@index([sasPanelId]) // أ-٢٣ · مشتركو لوحةٍ بعينها (المزامنة والتفعيل)
  @@map("subscribers")
}

// ===== ديون القروض (فزعة سوبر سيل) — منفصلة تماماً عن carry (طلب محمد 2026-08-06) =====
// دَينٌ تتبّعيّ لا يُحصَّل: لا زرّ تسديد، ولا يدخل التقرير اليوميّ إطلاقاً. يُمحى نهائيّاً
// بلا أيّ أثرٍ ماليّ عند تفعيل المشترك تفعيلاً عاديّاً. المزامنة تتجاهل صاحبه (له ٧ أيّام
// حقيقيّة في الساس و٣٠ يوماً وهميّة عندنا). لا يُعاد استعماله عبر carry كي لا يظهر في «الديون».
model LoanDebt {
  id            Int       @id @default(autoincrement())
  subscriberId  Int // المشترك صاحب القرض
  towerId       Int? // المكتب (للعزل والفلترة ونطاق الرؤية)
  agentId       Int? // الوكيل (المستأجر)
  amount        Float // مبلغ اشتراكه وقت المنح (35/45/65)
  packageId     Int? // الباقة وقت المنح
  netUser       String? // يوزر المشترك وقت المنح (للتدقيق ومطابقة الأمان)
  sasId         Int? // رقم الساس المستعمَل في المنح
  grantDate     DateTime  @default(now()) // تاريخ منح القرض (للبحث بين تاريخين)
  expiryVirtual DateTime? // تاريخ الانتهاء الوهميّ (تاريخ المنح + ٣٠)
  prevDateTo    DateTime? // تاريخ انتهاء المشترك **قبل** القرض — لإرجاعه عند الإلغاء العكسيّ
  createdByUser String? // مَن منح القرض (للمحاسبة)
  // «قرض عادي بلا إضافة أيام» (طلب محمد 2026-08-09): ليس دَيناً ماليّاً إطلاقاً — صفٌّ
  // وسمُه استثناء المزامنة فقط (يبقى تاريخ الانتهاء كما هو حتى تفعيلٍ بكارتٍ حقيقيّ يمحوه).
  // يُخفى من شاشة «ديون القروض» ومن مجموعها.
  noDays        Boolean   @default(false)
  isDeleted     Boolean   @default(false)

  updatedAt DateTime @default(now()) @updatedAt
  @@index([subscriberId])
  @@index([towerId])
  @@map("loan_debts")
}

// ===== الحسابات (acounts) =====
model Account {
  id        Int     @id @default(autoincrement())
  name      String?
  notes     String?
  type      Int?
  typeName  String?
  userId    Int?
  isEmployee Boolean @default(false) // حساب موظف (تنظيمي) — يبقى يؤثر على التقرير اليومي
  isActivationOffice Boolean @default(false) // «مكتب تفعيل»: عند تفعيل اشتراك يمكن حسم مبلغه عليه (واصل كامل + مصروف على الحساب، يتعادل التقرير)
  managerId Int? // حساب مدير في هذا المكتب — يُنشأ تلقائياً لكل مدير في كل مكتب
  towerId   Int? // المكتب المالك للحساب (قائمة حسابات مستقلة لكل مكتب؛ المدير يرى الكل)
  isDeleted Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([towerId])
  @@map("accounts")
}

// ===== وصولات التفعيل والتجديد (Sand) =====
model SubscriptionEntry {
  id           Int       @id @default(autoincrement())
  date         DateTime?
  notes        String?
  dateFrom     DateTime?
  dateTo       DateTime?
  money        Float?
  moneyIn      Float?
  moneyCarry   Float?
  moneyType    Int?
  cardType     String?
  withdrawal   Float?
  priceDollar  Float?
  deposit      Float?
  balance      Float?
  operation    String?
  subscriberId Int? // Sand_cosFk
  month        String?
  card2        String?
  withdrawalIq Float?
  towerId      Int? // Sand_fkBrig
  nextDate     DateTime?
  userId       Int?
  pushType     String?
  createdByUser String? // sand_user
  addPrice     Float? // Sand_add
  isMaster     Boolean   @default(false) // تفعيل ماستر (واصل كامل، ويُسجَّل بحساب الماستر المستقل)
  isDeleted    Boolean   @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([subscriberId])
  @@index([towerId])
  @@index([date])
  @@map("subscription_entries")
}

// ===== الحركات المالية (money) =====
model MoneyTx {
  id         Int       @id @default(autoincrement())
  moneyIn    Float?
  moneyOut   Float?
  accountId  Int? // money_acFk
  userId     Int?
  date       DateTime?
  notes      String?
  pc         String?
  serverDate DateTime?
  sourceType String? // مصدر الحركة: activation | invoice | debt | manual (لإلغائها عكسياً)
  sourceId   Int? // معرّف المصدر (وصل التفعيل/الفاتورة/المشترك)
  towerId    Int? // البرج/المكتب الذي تخصّه الحركة (لتقارير كل برج)
  salaryStatementId Int? // كشف الراتب الذي احتُسبت فيه هذه الحركة (لحساب الموظف) — يمنع تكرار احتسابها؛ لا تُحذف من التقرير اليومي
  // ===== تسديد مكاتب التفعيل/التوصيل (قرار محمد 2026-08-05) =====
  // ما يُحسم على «مكتب تفعيل» يبقى ديناً عليه حتى يسدّده أسبوعياً أو شهرياً. الوسم هنا:
  // settledAt متى سُدِّد هذا القيد، و settledTxId حركةُ القبض التي غطّته (تدخل تقرير يومها).
  // ورفع الوسم يعيد القيد ديناً وينقص حركة القبض بمقداره — فلا مالٌ يُقبض مرّتين ولا يضيع.
  settledAt   DateTime?
  settledTxId Int?
  isDeleted  Boolean   @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([accountId])
  @@index([date])
  @@index([sourceType, sourceId])
  @@index([towerId])
  @@index([settledTxId])
  @@map("money_tx")
}

// ===== الصندوق (box) =====
model Box {
  id        Int       @id @default(autoincrement())
  userId    Int?
  date      DateTime?
  idFrom    Int?
  idTo      Int?
  money     Float?
  type      Int?
  oldMoney  Float?
  notes     String?
  isDeleted Boolean   @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("boxes")
}

// ===== إيداعات/أقسام الصندوق (box_dep) =====
model BoxDep {
  id        Int     @id @default(autoincrement())
  name      String?
  type      Int?
  money     Float?
  isDeleted Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("box_deps")
}

// ===== كروت التفعيل (cards) =====
// ===== حساب مصروف/مقبوض المدير (لا يؤثر على التقرير اليومي) =====
// ===== المدير: هوية مالية للوكيل تتبع ما له/عليه =====
// ليست حساب دخول. لكل مدير حساب مصروف/مقبوض في **كل** مكاتب وكيله (يُنشأ تلقائياً،
// وكذلك في أي مكتب جديد لاحقاً). رصيده = كل ما أودعه في النظام − كل ما سحبه منه،
// عبر ثلاث قنوات: مكاتبه (تؤثر على تقاريرها) · حسابات المدير · الماستر.
model Manager {
  id        Int      @id @default(autoincrement())
  agentId   Int? // الوكيل المالك
  name      String
  note      String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([agentId])
  @@map("managers")
}

model ManagerTx {
  id        Int      @id @default(autoincrement())
  type      String // expense | receipt | card-payment | salary
  amount    Float
  notes     String?
  date      DateTime @default(now())
  userId    Int?
  byUser    String? // اسم المدير الذي أجرى الحركة (للتدقيق — يبقى ولو حُذف المستخدم)
  agentId   Int? // الوكيل (المستأجر) مالك الحركة — عزل حسابات المدير بين الوكلاء
  managerId Int? // المدير صاحب الحركة — null = من/إلى المبلغ الكلي مباشرة (مصاريف عامة)
  isDeleted Boolean  @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([type])
  @@index([agentId])
  @@map("manager_tx")
}

model RechargeCard {
  id           Int       @id @default(autoincrement())
  agentId      Int? // الوكيل (المستأجر) مالك مخزون الكروت — عزل الكروت بين الوكلاء
  number       String?
  password     String?
  serial       String? // سيريال الكارت
  packageId    Int? // الفئة/الباقة (50/100/150 ميكا)
  price        Float? // سعر شراء/كلفة الكارت الواحد (لحساب ديون الكارتات)
  subscriberId Int? // المشترك الذي استُخدم له
  reservedBy   Int? // مستخدم حجز الكارت مؤقتاً (سحب كارت)
  reservedAt   DateTime? // وقت الحجز المؤقت
  useDate      DateTime? // تاريخ الاستخدام النهائي (null = متاح)
  addDate      DateTime?
  userId       Int?
  userName     String?

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  // قيد فريد يمنع تكرار السيريال داخل الوكيل الواحد (طلب محمد 2026-08-07): مكتبان يرفعان
  // نفس الدفعة — ولو باللحظة نفسها — لا يُنشئان صفوفاً مكرّرة؛ القاعدة تردّ الثاني.
  // (السيريالات الفارغة NULL متمايزة في بوستغرس فلا تتعارض.)
  @@unique([agentId, serial])
  @@index([serial])
  @@index([packageId, useDate])
  @@map("recharge_cards")
}

// ===== المواد / المخزن (items) =====
model Item {
  id          Int     @id @default(autoincrement())
  name        String?
  category    String?
  priceDinar  Float?
  priceDollar Float?
  priceSale   Float?
  priceSale2  Float?
  type        Int?
  barcode     String?
  count       Float?
  minCount    Int?
  color       String?
  size        String?
  towerId     Int? // المكتب المالك للمخزن (مخزن مستقل لكل مكتب؛ المدير يرى الكل)
  isDeleted   Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([towerId])
  @@map("items")
}

// ===== الفواتير (fatora) =====
model Invoice {
  id           Int       @id @default(autoincrement())
  date         DateTime?
  number       Int?
  itemsCount   Float?
  totalMy      Float?
  waselHim     Float?
  pushType     Int?
