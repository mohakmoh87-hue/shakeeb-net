  itemId    Int? // item_fatora_itemfk
  count     Float?
  price     Float?
  buyPrice  Float?
  note      String?
  barcode   String?
  color     String?
  size      String?
  isDeleted Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([invoiceId])
  @@map("invoice_items")
}

// ===== التذاكر (tct) =====
model Ticket {
  id            Int       @id @default(autoincrement())
  agentId       Int? // الوكيل (المستأجر) مالك التذكرة — عزل البيانات
  createdByUser String?
  typeId        Int?
  priorityId    Int?
  statusId      Int?
  desc          String?
  note          String?
  tower         String?
  date          DateTime?
  dateClose     DateTime?
  isClosed      Int?
  closedByUser  String?
  depName       String?
  isDeleted     Boolean   @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("tickets")
}

model TicketType {
  id        Int     @id @default(autoincrement())
  name      String?
  isDeleted Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("ticket_types")
}

model TicketPriority {
  id        Int     @id @default(autoincrement())
  name      String?
  isDeleted Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("ticket_priorities")
}

model TicketState {
  id        Int     @id @default(autoincrement())
  name      String?
  isDeleted Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("ticket_states")
}

// ===== الأشهر (month) =====
model Month {
  id        Int       @id @default(autoincrement())
  name      String?
  notes     String?
  user      String?
  date      DateTime?
  month     String?
  money     Float?
  isDeleted Boolean   @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("months")
}

// ===== الملاحظات (notes) =====
model Note {
  id        Int       @id @default(autoincrement())
  name      String?
  text      String?
  date      DateTime?
  done      Int?
  category  String?
  desc      String?
  dateAlert DateTime?
  user      String?
  isDeleted Boolean   @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("notes")
}

// ===== الأحداث / التقويم (events) =====
model Event {
  id   Int       @id @default(autoincrement())
  name String?
  date DateTime?
  desc String?
  user String?

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("events")
}

// ===== إعدادات النظام (Setting_system) =====
model SystemSetting {
  id    Int     @id @default(autoincrement())
  type  String?
  value String?
  text  String?

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("system_settings")
}

// ===== قوالب الرسائل (Setting_sms) =====
model SmsTemplate {
  id     Int     @id @default(autoincrement())
  agentId Int? // الوكيل (المستأجر) مالك هذا الإعداد
  towerId Int? // المكتب (اختياري): قالب مخصّص لمكتب واحد يغلب قالب الوكيل العام (null = عام للوكيل)
  type   String?
  text   String?
  enable String?

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("sms_templates")
}

// ===== سجل الرسائل الصادرة (SMS / واتساب / تيليغرام) =====
enum MessageChannel {
  SMS
  WHATSAPP
  TELEGRAM
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

model Message {
  id            Int            @id @default(autoincrement())
  channel       MessageChannel @default(SMS)
  subscriberId  Int?
  phone         String?
  text          String
  status        MessageStatus  @default(PENDING)
  error         String?
  createdByUser String?
  // الوكيل (المستأجر) صاحب الرسالة — ضرورةُ عزل: الرسائل غير المرتبطة بمشترك (تقرير المدير
  // اليوميّ وتقرير المزامنة) كانت تُرشَّح باسم مُنشئها نصّاً، فمن يسمّي مستخدماً «scheduler»
  // يرى تقارير وكلاء آخرين. (تدقيق عدائيّ 2026-08-09)
  agentId       Int?
  date          DateTime       @default(now())

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([subscriberId])
  @@index([status])
  @@index([agentId])
  @@map("messages")
}

// ===== أنواع الإشعار (pushType) =====
model PushType {
  id        Int     @id @default(autoincrement())
  type      String?
  isDeleted Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("push_types")
}

// ===== إدارة الفنيين (لوحات كانبان على نمط Trello) — ميزة جديدة مستقلّة =====
model TaskBoard {
  id        Int      @id @default(autoincrement())
  name      String
  towerId   Int? // المكتب المالك للّوحة (null = لوحة عامة/الإدارة). لوحة مستقلة لكل مكتب.
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([towerId])
  @@map("task_boards")
}

// ===== الفنيون (لكل مكتب) — تُوجَّه لهم بطاقات إدارة الفنيين =====
model Technician {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  agentId   Int? // الوكيل (المستأجر) — للعزل ولتحديد الوكيل عند دخول الفني
  towerId   Int? // المكتب التابع له (null = غير محدّد)
  supportTowerId Int? // مكتب يدعمه هذا الفني مؤقتاً (يظهر ضمن فنّييه أيضاً)
  supportKind String? // نوع الدعم: "cards" بطاقات محدّدة | "day" يوم كامل
  sessionToken String? // جهاز واحد فقط: رمز آخر تسجيل دخول — الدخول من جهاز جديد يُبطل السابق
  extraTowerIds String? // مكاتب إضافية دائمة (JSON [ids]): يتصرف فيها كفنيّ أصلي (لوحات/ذمم/تنفيذ) — يضبطها المدير فقط
  ownCardsOnly Boolean @default(false) // رؤية بطاقاته فقط: لا يرى بطاقات زملائه ولا غير الموجَّهة
  // تخفيفٌ لـownCardsOnly (طلب محمد 2026-08-09): يرى بطاقاته **وبطاقات التوصيل** ولو لم تُسنَد إليه.
  // «التوصيل» بخاصيّة الفئة (CardType.deliveryOnly) لا باسمها — فعمود «جباية» موسومٌ بالتوصيل يراه.
  // رؤيةٌ فقط: الإسناد والتصرّف يبقيان كما هما (لا يعمل إلّا على المُسنَد إليه).
  seeDeliveryCards Boolean @default(false)
  // هل يُسمح للفنيّ بإنشاء بطاقاتٍ من تطبيقه؟ (طلب محمد 2026-08-09)
  // **مفعَّلٌ افتراضيّاً** كي لا يتغيّر شيءٌ على الوكلاء القائمين — إطفاؤه قرارٌ صريح من المدير.
  canAddCards Boolean @default(true)
  supportCardIds String? // JSON بمعرّفات بطاقات الدعم (لنوع cards) — يعود تلقائياً عند إكمالها
  accountId Int? // حساب المصروفات/المقبوضات (موظف) المرتبط بهذا الفني في نفس مكتبه
  // ===== تطبيق إدارة الفنيين: الدخول والحضور والراتب =====
  username  String?  @unique // اسم مستخدم فريد على مستوى النظام (لدخول تطبيق الفني)
  code      String? // رمز الدخول (كلمة السر) مُشفّر bcrypt
  plainCode String? // نسخة قابلة للعرض للمدير (يضبطها المدير)
  salary    Int? // الراتب الشهري
  shiftStart String? // بداية الدوام HH:MM
  shiftEnd   String? // نهاية الدوام HH:MM
  entryGraceMin Int? @default(0) // سماحية الدخول (دقائق)
  exitGraceMin  Int? @default(0) // سماحية الخروج (دقائق)
  lateRatePerMin     Int? @default(0) // سعر دقيقة الخصم (تأخير/خروج مبكّر)
  overtimeRatePerMin Int? @default(0) // سعر دقيقة الإضافي
  paidLeavesPerMonth Int? @default(0) // عدد إجازات الراتب المسموحة شهرياً
  missedCheckoutPenalty Int? @default(0) // غرامة نسيان بصمة الخروج (يضبطها المدير)
  bioCredId String? // معرّف بصمة الجهاز (WebAuthn) لتأكيد البصمة ببصمة الهاتف الحقيقية
  bioPublicKey   String?   // المفتاح العام (base64url) للتحقق الخادمي من التأكيد — غيابُه مع وجود bioCredId يعني تسجيلاً قديماً (عميل فقط) يلزم إعادة تسجيله
  bioCounter     Int?      // عدّاد توقيع المُصادِق (منع إعادة التشغيل) — يُحدَّث عند كل تحقق ناجح
  bioChallenge   String?   // التحدّي الجاري (تسجيل/مصادقة) — يُصدره الخادم، يُتحقق منه مرة، ثم يُمسح
  bioChallengeAt DateTime? // وقت إصدار التحدّي — تنتهي صلاحيته بعد دقائق (يمنع إعادة استخدامه)
  // تتبع الموقع بالطلب — لا سجل تاريخي: صف واحد يُستبدل بكل تحديث ويُمسح نهائياً عند الإيقاف
  trackReqAt DateTime? // آخر نبضة طلب تتبع من صفحة التتبع (طازجة = تتبع فعّال؛ قديمة = خمول)
  trackLat   Float? // آخر موقع (يُستبدل كل دقيقة)
  trackLng   Float?
  trackAt    DateTime? // وقت آخر تحديث موقع
  fcmToken  String? // رمز جهاز FCM (التطبيق الأصلي) — لإيقاظ الخدمة عند طلب التتبع
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([towerId])
  @@index([supportTowerId])
  @@index([agentId])
  @@map("technicians")
}

// ===== حضور الفنيين (بصمات دخول/خروج) — تطبيق إدارة الفنيين =====
model Attendance {
  id           Int       @id @default(autoincrement())
  technicianId Int
  agentId      Int? // عزل الوكيل
  towerId      Int?
  dayKey       String? // YYYY-MM-DD (توقيت بغداد) — يوم واحد لكل فني
  checkIn      DateTime? // بصمة الدخول المُحتسَبة (تُطبَّع لموعد الدوام عند التبكير)
  checkInActual  DateTime? // وقت بصمة الدخول الحقيقي الذي بصم فيه الفني فعلاً
  checkOut     DateTime? // بصمة الخروج المُحتسَبة
  checkOutActual DateTime? // وقت بصمة الخروج الحقيقي
  checkoutBy   String? // tech | manager (بصمة خروج يدوية من المدير)
  // ===== أ-١٠/القاعدة ٣ · أمكنةُ البصم تُحفَظ للشفافيّة لا للنسبة (قرار محمد 2026-08-11) =====
  // «يستطيع بصمَ دخولٍ من مكتبٍ والخروجَ من مكتبٍ آخر، وكلُّ الإجراءات ترجع إلى مكتبه الأصليّ.»
  // ⇒ `towerId` أعلاه = **المكتبُ الأصليّ دائماً** (الراتبُ والتقاريرُ والإشعارات)، وهذان
  // العمودان = **أين بصم فعلاً**. فيُعرَف المكانُ دون أن يتغيّر لمن يُحتسَب.
  // وصفٌّ واحدٌ لليوم كما هو (`@@unique([technicianId, dayKey])` لم يُكسَر).
  checkInTowerId  Int? // مكتبُ بصمة الدخول الفعليّ
  checkOutTowerId Int? // مكتبُ بصمة الخروج الفعليّ (كان يُكتَب حين يختلف فقط، ولا يُقرَأ)
  lateExcuse   String? // طلب «نسيت البصمة» عند الدخول المتأخّر: null | pending | approved | rejected — pending يُعلّق خصم التأخير حتى قرار المدير
  // المحسوب عند الخروج
  lateMinutes     Int? // دقائق تأخير الدخول (فوق السماحية)
  earlyMinutes    Int? // دقائق الخروج المبكّر
  overtimeMinutes Int? // دقائق الإضافي (فوق نهاية الدوام + السماحية)
  lateDeduction     Int? // خصم التأخير
  earlyDeduction    Int? // خصم الخروج المبكّر
  overtimeAddition  Int? // مبلغ الإضافي
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  // ===== (أ) · الوسمُ بدل الحذف (طلب محمد 2026-08-13) =====
  // «يلزمه أن يتوقّف التسديدُ عن الحذف النهائيّ ويُؤرشِف ما يحذف — فيُرجعه الإلغاءُ كاملاً
  //  **بأوقاته الحقيقيّة** لا مُعاداً بالدوام. وهذا يُصلح الجذرَ لا الأثر.»
  // 🔴 وكان التسديدُ يُنفّذ `deleteMany` على الحضور والخصومات والإجازات ⇒ فزرُّ الإلغاء
  // «يُصحّح المالَ والسجلَّ لا الفترة» بنصّ الكود نفسِه (حادثةُ أحمد عبد الرزاق).
  // والآن يُوسَم الصفُّ بالكشف الذي احتُسب فيه — **تماماً كنمط `MoneyTx.salaryStatementId`
  // القائم** — فلا يُعاد احتسابُه، **ويُرجعه الإلغاءُ بفكّ الوسم بأوقاته الحقيقيّة**.
  salaryStatementId Int?

  @@index([salaryStatementId])
  @@unique([technicianId, dayKey]) // بصمة واحدة (دخول+خروج) لكل فني في اليوم — تمنع الازدواج
  @@index([technicianId])
  @@index([agentId])
  @@map("attendances")
}

// ===== إجازات الفنيين — يوم (براتب/بلا حسب الحصّة الشهرية) أو زمنية؛ سبب إلزامي؛ قبول/رفض المدير =====
model Leave {
  id           Int      @id @default(autoincrement())
  technicianId Int
  agentId      Int? // عزل الوكيل
  towerId      Int?
  kind         String // "day" | "time"
  paid         Boolean  @default(false) // إجازة يوم مدفوعة (تُحتسب من الحصّة)
  dayKey       String // YYYY-MM-DD (توقيت بغداد) — يوم الإجازة
  startMin     Int? // إجازة زمنية: بداية الدقيقة من اليوم (بغداد)
  endMin       Int? // إجازة زمنية: نهاية الدقيقة من اليوم
  reason       String // إلزامي
  status       String   @default("pending") // pending | approved | rejected
  decidedBy    String? // اسم المدير الذي قرّر
  decidedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([technicianId])
  @@index([agentId])
  @@index([dayKey])
  // (أ) · يُوسَم بالكشف بدل الحذف — فيُرجعه الإلغاءُ كاملاً (انظر Attendance)
  salaryStatementId Int?

  @@index([salaryStatementId])
  @@map("leaves")
}

// ===== ذمم الفنيين (عهدة المواد) — كمية من مادة بحوزة فني، لا تُنقِص إجمالي المخزن =====
// المتبقي الكلي = Item.count ؛ بالمكتب = count − مجموع العهد ؛ يم الفني = العهدة.
model Custody {
  id           Int     @id @default(autoincrement())
  technicianId Int
  itemId       Int
  towerId      Int? // المكتب (لعزل الذمم لكل مكتب)
  qty          Float   @default(0)
  isDeleted    Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([technicianId])
  @@index([itemId])
  @@map("custodies")
}

model TaskList {
  id          Int      @id @default(autoincrement())
  boardId     Int // اللوحة المالكة
  name        String
  position    Int      @default(0)
  timeTracked Boolean  @default(false) // عمود محسوب بالوقت — تجاوز وقت الفئة يولّد خصماً معلّقاً
  isDeleted   Boolean  @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([boardId])
  @@map("task_lists")
}

model TaskCard {
  id           Int       @id @default(autoincrement())
  listId       Int // العمود المالك
  title        String
  description  String?
  assignee     String? // اسم الفني/الموظف (للعرض)
  technicianId Int? // الفني المسؤول (لتجميع التحصيل)
  subscriberId Int? // المشترك المصدر (لبطاقات العمليات) — لمنع بطاقتين فعّالتين لنفس المشترك
  kind         String    @default("maintenance") // maintenance = صيانة | delivery = توصيل
  label        String? // لون/تصنيف
  dueDate      DateTime?
  position     Int       @default(0)
  done         Boolean   @default(false)
  // دورة حياة البطاقة
  startedAt    DateTime? // وقت ضغط الفني «بدء» (يُخفى المحتوى قبله ويبدأ احتساب المدة)
  durationSec  Int? // مدة الإنجاز بالثواني (completedAt − startedAt)
  postponedTo  DateTime? // موعد التأجيل (عند عدم تواجد المشترك)
  // بيانات الإنجاز
  serviceDetails String? // تفاصيل الصيانة
  techNote      String? // ملاحظة يكتبها الفني على البطاقة (تُعرض على وجهها)
  amount        Float? // «المبيع» الصافي (المالي عبر فاتورة الصيانة) — وللتوصيل: مبلغه المعلوماتي
  subAmount     Float? // «اشتراك»: استلمه الفني للاشتراك — معلوماتي بلا أثر مالي (يُسجَّل عند التفعيل)
  materialsInfo String? // JSON بالمواد المباعة من الذمم (للعرض)
  completedAt   DateTime?
  settled       Boolean   @default(false) // تمّ التحصيل (اكمال)
  archivedAt    DateTime? // وقت الأرشفة (بعد التحصيل) — تبقى بالأرشيف أسبوعاً ثم تُحذف نهائياً
  history       String? // سجل تغييرات البطاقة JSON [{at,by,text}] (تأجيل/تحويل/نقل…)
  createdAt    DateTime  @default(now())
  isDeleted    Boolean   @default(false)
  // ربط أودو (Helpdesk) — بطاقة مصدرها تذكرة أودو
  odooTicketId Int? // رقم تذكرة أودو المصدر (منع تكرار + ربط الدفع العكسيّ)
  viaOdoo      Boolean   @default(false) // وسم «عبر أودو» — لا يزول عند إسناد فئة
  usernameRequired Boolean @default(false) // BG إلزاميّ (قيمة BG في أودو فارغة عند السحب)
  odooBg       String? // قيمة BG (اليوزر) التي أدخلها الفنيّ — تُدفَع إلى change_bg_field
  odooPushedAt DateTime? // وقت دفع الإنجاز/الإلغاء إلى أودو (null = لم يُدفَع بعد)
  // ===== مهلة سوبر سيل (SLA): ساعتان بلا إجراء = غرامة — النافذة ١٠:٠٠←٢٤:٠٠ بغداد =====
  odooCreatedAt DateTime? // زمن إنشاء التذكرة في أودو (create_date مُطبَّعاً UTC) — **مرجع العدّاد**
  odooFetchedAt DateTime? // لحظة سحبها عندنا (مهلة الرؤية تُحسب منها، وبوّابة التسليح تقارنها)
  // ═══ أ-٢٣ · لوحةُ أودو التي جاءت منها التذكرة (طلب محمد 2026-08-13) ═══
  // `null` = أودو المكتب (أعمدتُه = لوحتُه الأولى) · وإلّا لوحةٌ بعينها.
  // 🔴 **ولولا هذا العمود لوقع تنفيذٌ مزدوج**: الدفعُ والمهلةُ يفحصان بطاقاتِ **المكتب**، فلو
  // كان للمكتب حسابا أودو لعُومِلت كلُّ بطاقةٍ **مرّتَين** — إنذارٌ مرّتَين، و**رسالةُ واتسابٍ
  // للمشترك مرّتَين** (والشدنُ إرسالُه التلقائيُّ مُشعَلٌ فعلاً). فيُقصَر كلُّ حسابٍ على تذاكره.
  // 📌 والبطاقةُ تبقى على **لوحةِ مكتبٍ واحدة** فتظهر التذاكرُ كلُّها معاً في صفحةٍ واحدة —
  //    شرطُ محمد الصريح: «تظهر التذاكرُ كلُّها معاً بصفحة إدارة فنيّين واحدة».
  odooPanelId   Int?
  odooPhone     String? // هاتف التذكرة (partner_phone/mobile) — عمودٌ صريح لا استخراجاً نصّيّاً
  slaClaimedAt  DateTime? // حجزٌ ذرّيّ قبل الإرسال (يمنع إرسالاً مزدوجاً عند سباق القادة) — يسقط بعد ٥د
  // ملاحظة التأجيل اليدويّ ⇒ تُدفَع إلى أودو (الربط الثلاثيّ). **عمودٌ صريح** لا استخراجاً بـregex
  // من نصٍّ يملكه المستخدم: ملاحظةٌ بسطرين كانت تسقط فلا يُبلَّغ أودو أصلاً. وبطابعين منفصلين
  // يُدفَع **كلّ** تأجيلٍ لاحق (لا الأوّل وحده).
  postponeNote      String?
  postponeNoteAt    DateTime? // وقت كتابة آخر ملاحظة تأجيل
  postponePushedAt  DateTime? // وقت دفع تلك الملاحظة إلى أودو (أقدم منها ⇒ تُدفَع)
  slaAlertAt    DateTime? // إشعار المدير في الجرس — مرّةً واحدةً عند العتبة
  slaTechAt     DateTime? // آخر تنبيهٍ للفنيّ (كلّ ١٥ دقيقة حتى إنجاز البطاقة أو إلغائها)
  slaNoteAt     DateTime? // نجاح ملاحظة التأجيل في أودو ⇒ **خروجٌ نهائيّ من المهلة** (لا إنذار ثانٍ)
  slaWaQueuedAt DateTime? // رسالة المشترك في الطابور — تنفّذها حاسبة مكتبها حين تفتح
  slaWaSentAt   DateTime? // أُرسلت فعلاً إلى واتساب المشترك
  slaWaError    String? // سبب آخر فشل، أو «أُلغيت بعد يوم»

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([listId])
  @@index([technicianId])
  @@index([archivedAt])
  @@index([subscriberId])
  @@index([odooTicketId])
  @@index([odooPanelId])
  @@map("task_cards")
}

// سجل إنجازات البطاقات الدائم: البطاقة تُحذف من الأرشيف بعد أسبوع، وهذا السجل يبقى —
// لعدّ بطاقات كل فني حسب الفئة ضمن فترة راتبه (صفوف صغيرة، إدراج فقط)
model CardCompletion {
  id           Int      @id @default(autoincrement())
  cardId       Int
  technicianId Int
  agentId      Int?
  towerId      Int?
  kind         String?
  // زمن الإنجاز محفوظ هنا لأن البطاقة تُحذف بعد أسبوع من تحصيلها — وبدونه تصير
  // «إنجازات الفنيين» عمياء عن السرعة بعد أسبوع من كل بطاقة (قرار محمد 2026-08-05)
  durationSec  Int?
  completedAt  DateTime @default(now())

  @@index([technicianId, completedAt])
  @@map("card_completions")
}

// صورة إنجاز البطاقة (base64) — مفصولة لتفادي تضخّم استعلام اللوحة، وتُحذف فعلياً مع البطاقة/التحصيل
model CardPhoto {
  id        Int      @id @default(autoincrement())
  cardId    Int      @unique
  data      String // data URL (JPEG مضغوط)
  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("card_photos")
}

// جلسة واتساب كل مكتب منشورة في السحابة — ينشرها الوكيل ليقرأها الموقع (لعرض QR من الإنترنت)
// مُرحِّل عمليات واتساب بين الموقع (Vercel، بلا عميل) والوكيل (يملك العميل الحيّ).
// الموقع ينشئ طلباً (pending)، الوكيل القائد ينفّذه ويكتب النتيجة، الموقع يقرؤها.
model WaRelay {
  id        Int      @id @default(autoincrement())
  towerId   Int
  kind      String // chats | messages | send | logout
  params    String? // JSON: { chatId?, text?, limit? }
  status    String   @default("pending") // pending | running | done | error
  result    String? // JSON نتيجة التنفيذ
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@map("wa_relays")
}

// نقاط الخريطة (أعمدة المنطقة) — مرجع ثابت: اسم العمود ← إحداثيات. تُستورَد مرّة من ملف KMZ.
model MapPoint {
  name String  @id // مثل F2/1/MWA
  lat  Float
  lng  Float
  // ===== مصدر النقطة وأولويّته (قرار محمد 2026-08-05) =====
  // kml  = ملفٌ رفعه المالك — **له الأولوية**: يحلّ محلّ ما أضافه فني، ولا يُمسّ برفعٍ لاحق.
  // tech = أرسلها فنيّ من عند العمود وقبِلها المدير — سدّ ثغرة حتى يصل الملف الرسمي.
  source    String? // kml | tech
  updatedAt DateTime?

  @@map("map_points")
}

// ===== عمودٌ يقترحه الفني من موقعه (طلب محمد 2026-08-05) =====
// مشتركٌ عموده ليس على الخريطة = فنيٌّ يبحث عنه بالسؤال. والفني واقفٌ عند العمود فعلاً،
// فهو أصدق مَن يحدّده. يُرسل إحداثيه من هاتفه، ويصل المدير إشعارٌ فيقبل أو يرفض — ولا
// يُكتب في الخريطة الدائمة إلا بقبوله. واسم العمود يُحسب في الخادم من يوزر المشترك ومنطقة
// مكتبه (لا يُقبل من الهاتف) فلا يُسمّى عمودٌ باسم غيره.
model MapPointProposal {
  id           Int       @id @default(autoincrement())
  agentId      Int? // الوكيل (للعزل والإشعار)
  towerId      Int? // مكتب المشترك
  name         String // اسم العمود المحسوب: F{b}/{a}/{المنطقة}
  lat          Float
  lng          Float
  accuracy     Float? // دقّة الـGPS بالأمتار كما أفاد بها الجهاز
  netUser      String?
  subscriberId Int?
  technicianId Int? // الفني المُرسِل (إن كانت جلسة فني)
  byName       String? // اسم المُرسِل للعرض
  status       String    @default("pending") // pending | accepted | rejected
  note         String? // سبب الرفض أو ملاحظة المدير
  decidedById  Int?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  updatedAt DateTime @default(now()) @updatedAt
  @@index([agentId, status])
  @@index([name])
  @@map("map_point_proposals")
}

// رمز تنصيب لمرّة واحدة — يُسلّم رابط قاعدة البيانات للمُنصِّب بأمان (بلا إدخال يدوي ولا سكربت عام)
// ===== سجل مكافآت المشتركين (منح/استخدام) =====
model RewardLog {
  id            Int      @id @default(autoincrement())
  agentId       Int? // الوكيل (المستأجر) — للعزل والنسخ الاحتياطي
  towerId       Int? // مكتب العملية
  subscriberId  Int?
  kind          String // grant = منح عند التفعيل، redeem = استخدام/خصم
  amount        Int // المبلغ الممنوح أو المخصوم
  code          String? // الكود المرتبط بالعملية
  context       String? // activation | maintenance | sale
  refId         Int? // معرّف الوصل/البطاقة/البيع المرتبط
  balanceAfter  Int? // الرصيد بعد العملية
  subscriberName String? // اسم المشترك (للعرض في السجل)
  createdByUser String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([agentId])
  @@index([subscriberId])
  @@map("reward_logs")
}

model InstallToken {
  token     String   @id
  agentId   Int? // الوكيل الذي أنشأ الرمز
  createdBy Int? // معرّف المستخدم المنشئ
  expiresAt DateTime // تنتهي صلاحيته (نصف ساعة)
  usedAt    DateTime? // وقت أول استخدام (لمرّة واحدة)
  createdAt DateTime @default(now())

  @@map("install_tokens")
}

// ===== أوامر الطباعة الصامتة =====
// يُنشأ أمر عند فتح/طباعة وصل من أي جهاز، ويلتقطه العامل المحلي بحاسبة المكتب
// فيولّد PDF الوصل ويطبعه بصمت على الطابعة الافتراضية (بلا نافذة حوار إطلاقاً).
model PrintJob {
  id        Int       @id @default(autoincrement())
  agentId   Int? // الوكيل (عزل المستأجر)
  towerId   Int? // مكتب الطابعة (مكتب الوصل)
  kind      String // subscription | invoice
  refId     Int // معرّف الوصل (subscriptionEntry.id أو invoice.id)
  status    String    @default("pending") // pending | printing | done | failed
  error     String?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  updatedAt DateTime @default(now()) @updatedAt
  @@index([status, createdAt])
  @@map("print_jobs")
}

model WaSession {
  towerId     Int       @id // المكتب
  state       String    @default("disconnected") // disconnected|starting|qr|authenticated|ready|error
  qr          String? // نص الـQR الخام (يحوّله الموقع لصورة)
  error       String?
  requestedAt DateTime? // طلب اتصال من الموقع (يلتقطه الوكيل ويبدأ التشغيل)
  // مالكة الجلسة الحصرية (MACHINE_ID لحاسبةٍ وصلت ready): أي حاسبة أخرى تحمل نسخة
  // قديمة من هذه الجلسة تحذفها ذاتياً — يمنع تقاتل حاسبتين على نفس الجلسة (إبطال واتساب)
  hostMachineId String?
  updatedAt   DateTime  @updatedAt

  @@map("wa_sessions")
}

// حواسيب المكاتب المُسجَّلة في النظام الهجين (العمّال) — للأولوية وانتخاب القائد (مضيف واتساب)
model HybridWorker {
  id        Int      @id @default(autoincrement())
  machineId  String  @unique // معرّف ثابت للحاسبة (يولّده المُنصِّب)
  agentId    Int? // الوكيل المالك للحاسبة — تُحدَّد عند اعتماد المدير؛ عزل جلسات الواتساب لكل وكيل
  name       String? // اسم الجهاز التلقائي (hostname) — تكتبه نبضة العامل
  displayName String? // الاسم الذي يحدّده المدير — لا تلمسه النبضة (يمنع رجوعه للاسم القديم)
  approved   Boolean @default(false) // لا تصبح جزءاً فعّالاً من النظام الهجين إلا بموافقة المدير
  blocked    Boolean @default(false) // محظورة: حذفها المدير — تُخفى من اللوحة ويتوقّف عاملها إن اكتشفها
  nodeNumber Int? // رقم العقدة في نظام المعرّفات المُنطَّقة (السحابة=0، الحواسيب 1..)؛ نطاقها = nodeNumber×10^8
  towerId    Int? // المكتب التابع له (اختياري)
  priority  Int      @default(100) // الأصغر = أعلى أولوية ليكون القائد
  lastSeen  DateTime @default(now()) // آخر نبضة heartbeat
  configAt  DateTime? // آخر مرة جلبت فيها الحاسبة إعداداتها من الموقع (الربط الذاتي)
  printers  String? // قائمة طابعات هذه الحاسبة (JSON بأسماء) — تكتبها النبضة لاختيار طابعة الوصل
  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("hybrid_workers")
}

// أنواع البطاقات (توصيل/تحويل/اعادة/صيانة/تنصيب + أنواع يضيفها المستخدم)
// deliveryOnly = بطاقة مبلغ فقط (كالتوصيل) لا تتطلّب تفاصيل/صورة عند الإنجاز.
model CardType {
  id              Int     @id @default(autoincrement())
  agentId         Int? // الوكيل (المستأجر) مالك هذا الإعداد
  name            String
  deliveryOnly    Boolean @default(false)
  // بوّابة النوع للتوزيع التلقائي — لا تعمل وحدها: يلزم معها مفتاح المكتب
  // Tower.autoAssignEnabled (النوع مملوك للوكيل لا للمكتب، فبوّابة واحدة كانت
  // ستُفعّل التوزيع على كل مكاتب الوكيل دفعةً — خلاف شرط محمد الصريح 2026-08-03)
  autoAssign      Boolean @default(false)
  execMinutes     Int? // الوقت المسموح لإنجاز هذا النوع (دقائق) — أساس احتساب التجاوز
  overrunDeduction Int? // خصم لكل دقيقة تجاوز فوق الوقت المسموح
  // ===== نقاطُ الإنجاز لهذه الفئة (طلب محمد 2026-08-13) =====
  // «أن يقوم المديرُ بإعطاء نقاطٍ لكلّ فئةٍ حسب ما يرغب، **ويمكن أن يكون صفراً**، لمتابعة
  // إنجازات الفنيّين.» وكانت الأوزانُ **مسمَّرةً في `achievements.ts`** بقرارٍ سابقٍ له
  // («ثابتةٌ في الكود… لا تُعدَّل من الشاشة») — وهذا نقضُه بطلبه.
  // 🔑 و`null` **ليس صفراً**: فارغٌ = «استعمِل الوزنَ المبنيَّ في الكود كما هو اليوم»
  // ⇒ لا يتغيّر شيءٌ على أيّ وكيلٍ لم يُعدِّل. و`0` قرارٌ صريحٌ: الفئةُ **لا تُحتسَب**.
  achievementWeight Float?
  position        Int     @default(0)
  isDeleted       Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@map("card_types")
}

// ===== خصومات/مكافآت الفني المعلّقة — تجاوز وقت البطاقة يولّد خصماً معلّقاً يؤكّده/يرفضه المدير =====
model Adjustment {
  id           Int       @id @default(autoincrement())
  technicianId Int
  agentId      Int? // عزل الوكيل
  towerId      Int?
  kind         String // "deduction" خصم | "bonus" مكافأة
  source       String // "overrun" تجاوز وقت | "manual" يدوي
  amount       Int // موجب دائماً؛ النوع يحدّد الاتجاه
  reason       String
  cardId       Int? // البطاقة المسبّبة (لتجاوز الوقت)
  overrunMin   Int? // دقائق التجاوز (توثيق)
  status       String    @default("pending") // pending | confirmed | rejected
  dayKey       String // YYYY-MM-DD (بغداد) — للتجميع الشهري في الرواتب
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([technicianId])
  @@index([agentId])
  // (أ) · يُوسَم بالكشف بدل الحذف — فيُرجعه الإلغاءُ كاملاً (انظر Attendance)
  salaryStatementId Int?

  @@index([salaryStatementId])
  @@index([status])
  @@map("adjustments")
}

// ===== كشف راتب مؤرشَف — لقطة مضغوطة عند التسديد؛ يُصفَّر بعدها سجل الفني الخام =====
model SalaryStatement {
  id                   Int      @id @default(autoincrement())
  technicianId         Int
  technicianName       String
  agentId              Int? // عزل الوكيل
  towerId              Int?
  periodFrom           String // dayKey أول سجل محتسب
  periodTo             String // dayKey التسديد
  daysPaid             Int // أيام محتسبة (حضور + إجازة براتب)
  dailyAmount          Int // متوسط مبلغ اليوم
  baseEarned           Int // مجموع مبالغ الأيام
  overtime             Int // مجموع الإضافي
  bonuses              Int // مجموع المكافآت المؤكّدة
  attendanceDeductions Int // خصومات التأخير/الخروج المبكّر
  confirmedDeductions  Int // خصومات معلّقة مؤكّدة (تجاوز الوقت…)
  net                  Int // الصافي المحسوب = مجموع الخانات السبع بالضبط (لا يُمَسّ)
  // ===== أ-١٦ · تقريب الراتب إلى الألف — والمستفيد دائماً الفنيّ (طلب محمد 2026-08-12) =====
  // الأعمدة أُنشئت في القاعدة بـ`scripts/add-salary-rounding-carry.mjs`، وتُعلَن هنا كي
  // تستطيع بريزما الكتابة فيها. وكلّها اختياريّة فالكشوف القديمة تبقى صحيحة بلا قيم.
  paidAmount           Int? // المدفوع فعلاً بعد التقريب. و`net` يبقى كما هو فلا ينفرط اتّساق الخانات
  roundingAdd          Int? // ما أُضيف للتقريب (٠…٩٩٩) — يُعرَض سطراً أعلى تفاصيل الراتب
  carryIn              Int? // مُرحَّل من الفترة السابقة (سالب = دَين على الفنيّ) — يُستعمل في ب-٠٠
  carryOut             Int? // المتبقّي المُرحَّل للفترة التالية (سالب أو صفر) — يُستعمل في ب-٠٠
  cancelledAt          DateTime? // لحظة إلغاء الكشف؛ والفهرس الفريد الجزئي يستثني الملغى
  details              String // JSON بالبنود المؤثّرة (تاريخ/نوع/مبلغ/سبب)
  paidByUser           String?
  moneyTxId            Int? // قيد الصرف المرتبط
  createdAt            DateTime @default(now())

  @@index([technicianId])
  @@index([agentId])
  @@map("salary_statements")
}

// ===== إشعارات المدير — أحداث الفنيين (بصمة/إجازة/خصم معلّق) =====
model Notification {
  id        Int      @id @default(autoincrement())
  agentId   Int? // عزل الوكيل
  towerId   Int? // مكتب الحدث
  type      String // checkin | checkout | leave | deduction
  title     String
  body      String
  refType   String? // technician | leave | adjustment
  refId     Int?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([towerId])
  @@index([read])
  @@map("notifications")
}

// ===== اشتراكات Web Push للمدير (VAPID) =====
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int // المستخدم المشترِك (المدير)
  agentId   Int? // للعزل والاستهداف
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([agentId])
  @@map("push_subscriptions")
}

// سجل صيانات المشترك (بجانب سجل الوصولات) — تفاصيل الصيانة من الفني وتاريخها؛ بلا صور.
model MaintenanceLog {
  id             Int      @id @default(autoincrement())
  subscriberId   Int
  details        String
  technicianName String?
  cardTitle      String?
  kind           String? // نوع البطاقة (صيانة/تنصيب...)
  durationSec    Int? // مدة إنجاز الفني للبطاقة بالثواني
  amount         Float? // مبلغ البطاقة المستلم من المشترك
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt // تتبّع التغييرات للمزامنة
  @@index([subscriberId])
  @@map("maintenance_logs")
}

// ===== أ-٢٣ · لوحاتُ الساس/أودو لمكتبٍ واحد (طلب محمد 2026-08-12) =====
// المبدأ: **«المكتب» وحدةُ عمل، و«لوحةُ الساس» نقطةُ بنيةٍ تحتيّة** — والبرنامجُ كان يخلطهما
// ١:١ في `Tower`، وحاجةُ محمد ١:عدّة (وكيلٌ يدير مكتبَين بواتساب واحدٍ وحاسبةٍ واحدةٍ ومستخدمٍ
// واحد، ولكلّ مكتبٍ **رابطُ ساسٍ ورابطُ أودو مختلفان**).
//
// وقياسُ الطريقَين قبل القرار: دمجُ سلوكِ مكتبَين يمسّ `towerId` في **١٠١٠ موضعاً و٢٩٩ نداءَ عزل**؛
// وهذا الجدولُ يمسّ **~١١٧ موضعاً وصفرَ نداءِ عزل** (فالمكتبُ يبقى واحداً). ⇒ اختار محمد هذا.
//
// والهجرةُ **إضافيّةٌ صافية**: تُولَّد لوحةٌ أولى لكلّ مكتبٍ من أعمدته الحاليّة، و`Subscriber.sasPanelId`
// يبقى فارغاً للجميع ⇒ كلُّ قارئٍ يسقط إلى أعمدة المكتب كما اليوم، فلا يتغيّر سلوكُ أيّ وكيل.
model SasPanel {
  id                 Int      @id @default(autoincrement())
  towerId            Int // المكتب المالك — والعزلُ يتبعه كما هو
  agentId            Int? // نسخةٌ للعزل السريع (كما في بقيّة الجداول)
  label              String? // «صميم١» / «صميم٢» — يُعرَض جنباً إلى جنب
  sortOrder          Int      @default(0)
  isPrimary          Boolean  @default(false) // اللوحةُ المولَّدة من أعمدة المكتب
  isDeleted          Boolean  @default(false)
  // ── الساس ──
  loginUrl           String?
  username           String?
  password           String?
  activationTemplate String?
  // ── أودو (لكلّ لوحةٍ بوّابتُها — طلبُ محمد: «رابطان لأودو بدل واحد») ──
  odooEnabled        String?  @default("0")
  odooUrl            String?  @default("https://odoo.supercell.iq")
  odooUser           String?
  odooPass           String? // نصٌّ صريح كما في `Tower` (يقرؤها العاملُ المحليّ بلا مفتاح)
  odooUid            Int?
  odooLastOk         DateTime?
  odooLastError      String?
  odooLastTicketId   Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([towerId])
  @@index([agentId])
  @@map("sas_panels")
}

// ===== «سلامة المال» · تجاهُلُ حالةٍ فلا تُعاد أبداً (طلب محمد 2026-08-12) =====
// «يمكنه ضغط تجاهل فلا تُعاد له مرّةً أخرى». والهويّةُ `rowKey` (مثل `tx:2541`) تجعل التجاهلَ
// **لحالةٍ بعينها** لا لصنفٍ كامل — فلا يُخفي تجاهلُ خللٍ خللاً آخرَ من نوعه.
// ولا حذفَ للبيانات ولا إصلاحَ صامت: التجاهلُ **إخفاءٌ من القائمة فقط**، والمالُ كما هو.
model MoneyHealthIgnore {
  id        Int      @id @default(autoincrement())
  agentId   Int // عزل: لكلّ وكيلٍ تجاهلاتُه
  checkKey  String // مفتاحُ الحقيقة (ثابتٌ في الكود)
  rowKey    String // هويّةُ الحالة بعينها
  note      String? // سببُ التجاهل إن كتبه
  byUser    String?
  createdAt DateTime @default(now())

  @@unique([agentId, checkKey, rowKey])
  @@index([agentId])
  @@map("money_health_ignores")
}
